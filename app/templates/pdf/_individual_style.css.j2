.form-title { border: 1px solid #000; width: 62%; margin: 0 auto 14pt; padding: 7pt 0; text-align: center; font-weight: bold; font-size: 18pt; }
  .indent1 { padding-left: 1.3cm; }
  .q { padding-left: 0.8cm; }
  .chk { font-family: "DejaVu Sans"; font-size: 10pt; padding: 0 2pt 0 8pt; }
  .methods td { border: none; padding: 1pt 2pt; font-size: 15pt; white-space: nowrap; }
  .rank { display: inline-block; line-height: 1.05; min-width: 30pt; border-bottom: 1px dotted #000; text-align: center; }
  .eval td, .eval th { font-size: 15pt; line-height: 1.05; padding: 1.5pt 4pt; }
  .eval td.item { padding-left: 4pt; }
  .eval td.note { font-size: 14.5pt; padding: 2pt 6pt; }
  .note-line { border-bottom: 1px dotted #000; min-height: 13pt; margin: 1pt 0 3pt; }
  .comment-line { border-bottom: 1px dotted #000; min-height: 17pt; white-space: pre-wrap; }
  .sign-left { margin: 12pt 0 0 1cm; }
  .sign-left .name { padding-left: 1cm; }
  table.ln.indent1 td:first-child { padding-left: 1.3cm; }
  table.ln.q td:first-child { padding-left: 0.8cm; }
  td.nw { white-space: nowrap; font-size: 15pt; }
  .ln td.c { text-align: center; }
