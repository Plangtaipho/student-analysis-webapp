# Copy to .env for local development. Never commit the real .env.
ENV=development
# Local default is SQLite. Production (Railway) gives MYSQL_URL; set DATABASE_URL to it.
DATABASE_URL=sqlite:///./dev.db
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Public address used in student links / QR codes (empty = current request address)
PUBLIC_BASE_URL=
# First admin account, created at startup when no admin exists
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Price of one semester in baht (all classrooms of that term)
PRICE_PER_TERM=129
# PromptPay receiver: mobile number or 13-digit ID (kept only in Railway variables)
PROMPTPAY_ID=
# Account name shown to teachers before they transfer
PROMPTPAY_NAME=

# Sign in with Google (optional). OAuth client of type "Web application";
# redirect URI = PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
